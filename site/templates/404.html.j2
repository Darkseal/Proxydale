{% extends "base.html.j2" %}
{% block title %}Page not found | {{ site_name }}{% endblock %}
{% block description %}That page does not exist on the Proxydale site.{% endblock %}

{% block content %}
    <section class="section section--notfound">
      <div class="container">
        <p class="eyebrow">Error 404</p>
        <h1 class="section__title">This chair is empty</h1>
        <p class="section__intro">
          The page you asked for is not here. It may have moved when the site was rebuilt.
        </p>
        <div class="cta-row">
          <a class="button button--primary" href="{{ home }}">Back to the home page</a>
          <a class="button" href="{{ home }}#downloads">Go to downloads</a>
        </div>
      </div>
    </section>
{% endblock %}
