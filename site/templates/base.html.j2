<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% block title %}{{ site_name }}{% endblock %}</title>
  <meta name="description" content="{% block description %}{% endblock %}" />
  {% if canonical is not none %}
  <link rel="canonical" href="{{ site_url }}/{{ canonical }}" />
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="{{ 'assets/css/styles.css' | url(base) }}" />
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>

  <header class="site-header">
    <div class="container nav-container">
      <a class="brand" href="{{ home }}#top">
        <span class="brand__mark" aria-hidden="true">◆</span>
        <span class="brand__name">Proxydale</span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="nav-toggle__bars" aria-hidden="true"></span>
        <span class="visually-hidden">Menu</span>
      </button>
      <nav class="nav-links" id="site-nav" aria-label="Sections">
        {% for anchor, label in nav %}
        <a href="{{ home }}#{{ anchor }}" data-section="{{ anchor }}">{{ label }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  <main id="content">
{% block content %}{% endblock %}
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-about">
        <div class="footer-title">Unofficial fan-made content</div>
        <p>
          Blood on the Clocktower is a social deduction game of secrets, logic, and deception, in
          which players take on unique roles with special abilities while a Storyteller guides the
          game and the narrative. It is published by The Pandemonium Institute.
        </p>
        <p class="footer-legal">
          Blood on the Clocktower is &copy; The Pandemonium Institute. All rights reserved.<br />
          Official site:
          <a href="{{ official_site }}" target="_blank" rel="noopener">
            bloodontheclocktower.com <span aria-hidden="true">&#8599;</span>
          </a>
        </p>
      </div>
      <div class="footer-meta">
        <div class="footer-credit">Created by Dark @ BotC Italia</div>
        <ul class="social" aria-label="BotC Italia">
          {% for item in social %}
          <li>
            <a href="{{ item.url }}" title="{{ item.name }}" aria-label="{{ item.name }}"
               target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="{{ item.path }}" />
              </svg>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </footer>

  <script src="{{ 'assets/js/site.js' | url(base) }}" defer></script>
</body>
</html>
