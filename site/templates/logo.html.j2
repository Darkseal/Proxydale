{# The Proxydale mark: a six-seat circle, half taken, half empty. Same visual
   language as the diagram in "How it works", reduced to the one idea the
   variant is built on. Colours come from CSS, so it works in any context. #}
<svg class="logo{{ ' ' ~ extra_class if extra_class is defined else '' }}" viewBox="0 0 32 32"
     role="img" aria-label="Proxydale" focusable="false">
  <g class="logo__taken">
    <circle cx="16" cy="6.5" r="3" />
    <circle cx="24.23" cy="20.75" r="3" />
    <circle cx="7.77" cy="20.75" r="3" />
  </g>
  <g class="logo__empty">
    <circle cx="24.23" cy="11.25" r="3" />
    <circle cx="16" cy="25.5" r="3" />
    <circle cx="7.77" cy="11.25" r="3" />
  </g>
</svg>
